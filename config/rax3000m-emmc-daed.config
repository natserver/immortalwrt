# ImmortalWrt v25.12.2 · CMCC RAX3000M (eMMC) + daed
# 目标: 与 natserver/NatserverWrt 完全一致的 daed("dead") 插件集合

# ================= Target =================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000m=y

# ================= 系统分区（production / p5）=================
# 该值经 target/linux/mediatek/image/filogic.mk 的 Build/mt798x-gpt 传给 ptgen：
#     -t 0x2e -N production -p $(CONFIG_TARGET_ROOTFS_PARTSIZE)M@64M
# ⇒ 生成出来的 emmc-gpt.bin 里 production 分区 = 8192 MiB，起始 64 MiB、结束 8256 MiB。
# 设备 eMMC 为 64GB，8G 系统分区之外的剩余空间目前不建分区（保持与 ImmortalWrt 官方布局一致）。
#
# 刷机后 overlay 可用空间 = production 分区 − FIT 镜像大小：
#   target/linux/generic/pending-6.12/510-block-add-uImage.FIT-subimage-block-driver.patch
#   里 "mapped remaining space as /dev/fitrw" 就是把 production 分区尾部剩余空间
#   直接映射成 overlay（约 8 GiB − 48 MiB ≈ 8 GiB）。
#
# ⚠ 8G 只在「刷了 emmc-gpt.bin」之后才成立：sysupgrade 不重写分区表。
#   官方刷机第 2 步（dd if=<...>-emmc-gpt.bin of=/dev/mmcblk0 bs=512 seek=0 count=34）必须执行。
#   workflow 的「校验产物」步骤会解析 emmc-gpt.bin 硬断言这里确实是 8192 MiB。
CONFIG_TARGET_ROOTFS_PARTSIZE=8192

# ================= 版本信息 (与 ax1800pro 一致) =================
# VERSION_DIST 被 if VERSIONOPT 包裹，VERSIONOPT 的提示又依赖 IMAGEOPT；
# 两个开关不打开的话 CONFIG_VERSION_DIST 会被 defconfig 丢弃。
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="NatserverWrt"
CONFIG_KERNEL_BUILD_USER="natserver"
CONFIG_KERNEL_BUILD_DOMAIN="NatserverWrt"

# ================= 内核 eBPF / BTF (dae、daed 依赖) =================
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y

# ================= 可选编译选项 =================
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y

# ================= dae / daed (kenzok8/openwrt-daede) =================
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-i18n-daede-zh-cn=y
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y
CONFIG_PACKAGE_vmlinux-btf=m

# ================= daed 运行时依赖 =================
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
# 官方 daed 的 geo 数据是软链到 /usr/share/v2ray/，需要这两个包补齐
CONFIG_PACKAGE_daed-geoip=y
CONFIG_PACKAGE_daed-geosite=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y

# ================= 常用组件 =================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-ttyd=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_usbutils=y

# ===============================================================
# iStoreOS 应用商店（iStore）
# 参考 imm.sh 的 do_istore()：luci-app-store + luci-lib-taskd + luci-lib-xterm + taskd。
# 这里改为源码编译（store feed 由 scripts/diy-part1.sh 追加），无需刷机后再联网装 ipk。
# ===============================================================
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
# iStore 的前端页面是老式 CBI 写法，需要 luci-compat 提供 /usr/lib/lua/luci/cbi.lua
# （imm.sh 里也有一句 [ -s /usr/lib/lua/luci/cbi.lua ] || opkg install luci-compat）
CONFIG_PACKAGE_luci-compat=y

# luci-app-store 自己的 Makefile 声明：
#     LUCI_DEPENDS:=+curl +tar +libuci-lua +mount-utils +luci-lib-taskd
#     （luasrc/ 存在时 luci.mk 还会自动追加 +luci-lua-runtime）
# 其中 libuci-lua 的依赖是 +libuci +liblua，而 liblua 由 package/utils/lua 提供
# （该 Makefile 里有 $(eval $(call BuildPackage,liblua))）。
# 这条链任何一环解析不出来，luci-app-store 就会被 defconfig 静默丢弃，
# 所以全部逐项显式写出来，缺哪一环构建日志里能一眼看到。
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_luci-base=y

# taskd 的硬依赖：DEPENDS:=+procd +script-utils +coreutils +coreutils-stty
#   script-utils   来自 package/utils/util-linux（不是独立包）
#   coreutils-stty 来自 utils/coreutils 的自动拆分子包
# OpenWrt 的 defconfig 对「依赖不满足」的包是【静默丢弃】：缺任何一个，
# taskd 消失 → luci-lib-taskd（+taskd）消失 → luci-app-store（+luci-lib-taskd）消失，
# 最后表现为「应用商店菜单根本没有」。所以整条链逐项显式写出来。
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-stty=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_unzip=y

# ---------------------------------------------------------------------------
# 【关键】tar 的条件依赖，缺一个 luci-app-store 就会整个消失
#
# packages/utils/tar/Makefile 里：
#     define Package/tar
#       DEPENDS:= +PACKAGE_TAR_BZIP2:bzip2 +PACKAGE_TAR_POSIX_ACL:libacl \
#                 +PACKAGE_TAR_XATTR:libattr +PACKAGE_TAR_ZSTD:libzstd \
#                 +PACKAGE_TAR_XZ:xz
#     define Package/tar/config
#       config PACKAGE_TAR_BZIP2   default y
#       config PACKAGE_TAR_GZIP    default y
#       config PACKAGE_TAR_XZ      default y     ← 默认就开
#       config PACKAGE_TAR_ZSTD    default y     ← 默认就开
#
# 于是 Kconfig 里 tar 带上了
#     depends on !(PACKAGE_TAR_XZ) || PACKAGE_xz-utils
# 这类条件。默认 PACKAGE_TAR_XZ=y，只要不装 xz-utils，条件即为假：
#     tar 不可见 → 依赖 tar 的 luci-app-store 也不可见
#   ⚠️ 而 Kconfig 里【不可见的符号不会写进 .config】——
#      连「# CONFIG_PACKAGE_luci-app-store is not set」都不会出现，
#      表现为「包在 tmp/.packageinfo 里、依赖全 =y、.config 里却查无此符号」，
#      极易误判为 defconfig 丢包。这就是本项目排查了很久的那个坑。
#
# 顺带：iStore 自身解 apk/ipk 也要用 xz/bzip2/zstd。
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_bzip2=y
CONFIG_PACKAGE_libzstd=y

# ===============================================================
# iStoreOS 外观：Argon 主题
# iStoreOS 官方 feeds.conf.default 里那句注释 "argon, etc." 就是指这套主题。
# immortalwrt/luci 自带 themes/luci-theme-argon + applications/luci-app-argon-config，
# 不需要额外开 third 源，避免同名包冲突。
# 包内自带 root/etc/uci-defaults/30_luci-theme-argon，全新刷机会自动设为默认主题。
# ===============================================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ===============================================================
# 中文界面 / 分区工具
# ===============================================================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
# 需要手工调整分区时用得上（parted 改 GPT，e2fsprogs 提供 resize2fs）
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
